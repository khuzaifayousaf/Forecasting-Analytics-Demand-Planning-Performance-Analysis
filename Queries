--Forecast Analysis ------
---->>>>>>>>>>>>>>>>>>>>>>>>>>>>
--- Forecast Error -----
select*,
(Actual_Demand - Forecast_Demand) as Forecast_Error
from (
select
month(f.Date) as Months,
sum(f.Actual_Demand_Qty) as Actual_Demand,
sum(f.Forecast_Qty) as Forecast_Demand
from Silver.fact_forecast_demand as f
group by month(f.Date)
)t
order by Months asc;
---->>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
---- Percentage Error -----
select*,
format((Actual_Demand - Forecast_Demand)/ cast
		(Actual_Demand as float),'p') as Percentage_Error
from (
select
month(f.Date) as Months,
sum(f.Actual_Demand_Qty) as Actual_Demand,
sum(f.Forecast_Qty) as Forecast_Demand
from Silver.fact_forecast_demand as f
group by month(f.Date)
)t
order by months asc;
--->>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
--- Absolute Error ----
select*,
abs(Actual_Demand - Forecast_Demand) as Absolute_Error
from (
select
month(f.Date) as Months,
sum(f.Actual_Demand_Qty) as Actual_Demand,
sum(f.Forecast_Qty) as Forecast_Demand
from Silver.fact_forecast_demand as f
group by month(f.Date)
)t;
---->>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
--- APE (Absolute Percentage Error )
select*,
format((abs(Actual_Demand - Forecast_Demand))
	/cast(Actual_Demand as float),'p') as Absolute_Percentage_Error
from (
select
month(f.Date) as Months,
sum(f.Actual_Demand_Qty) as Actual_Demand,
sum(f.Forecast_Qty) as Forecast_Demand
from Silver.fact_forecast_demand as f
group by  month(f.Date)
)t
order by Months asc;
--->>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
--- MAE (Mean Absolute Error ) Two Ways
with forecast as (
select
month(f.Date) as Months,
sum(f.Actual_Demand_Qty) as Actual_Demand,
sum(f.Forecast_Qty) as Forecast_Demand
from Silver.fact_forecast_demand as f
group by month(f.Date)
)
select*,
round((Sum_Abs_Error / cast(n as float)),2)
		as Mean_Absolute_Error
from (
select
f.Months,
sum(abs(f.Actual_Demand - f.Forecast_Demand))
		over() as Sum_Abs_Error,
count(f.Months) over() as n
from forecast as f
)t;
----- Second Way
select*,
avg(abs(t.Actual_Demand - t.Forecast_Demand))
		over() as Mean_Absolute_Error
from (
select
month(f.Date) as Months,
sum(f.Actual_Demand_Qty) as Actual_Demand,
sum(f.Forecast_Qty) as Forecast_Demand
from Silver.fact_forecast_demand as f
group by month(f.Date)
)t;
----->>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
--- MAP (Mean Absolute Percentage Error )
with forecast as (
select
month(f.Date) as Months,
sum(f.Actual_Demand_Qty) as Actual_Demand,
sum(f.Forecast_Qty) as Forecast_Demand
from Silver.fact_forecast_demand as f
group by month(f.Date)
)
select*,
((round(avg(abs((Actual_Demand - Forecast_Demand)
	/cast(Actual_Demand as float)))
			over(),4))*100) as MAPE
from forecast;
----->>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
--- Forecast Accuracy ------------
with forecast as (
select
month(f.Date) as Months,
sum(f.Actual_Demand_Qty) as Actual_Demand,
sum(f.Forecast_Qty) as Forecast_Demand
from Silver.fact_forecast_demand as f
group by month(f.Date)
)
select*,
100 - ((round(avg(abs((Actual_Demand - Forecast_Demand)
	/cast(Actual_Demand as float)))
			over(),4))*100) as Forecast_Accuracy_Percentage
from forecast;
---->>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
--- Forecast Bias ------------
with forecast as (
select
month(f.Date) as Months,
sum(f.Actual_Demand_Qty) as Actual_Demand,
sum(f.Forecast_Qty) as Forecast_Demand
from Silver.fact_forecast_demand as f
group by month(f.Date)
)
select*,
sum(Actual_Demand - Forecast_Demand) over()
		as Forecast_Bias
from forecast;
---->>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
--- WAPE ( Weighted Absolute Percentage Error ) ---------
with forecast as (
select
month(f.Date) as Months,
sum(f.Actual_Demand_Qty) as Actual_Demand,
sum(f.Forecast_Qty) as Forecast_Demand
from Silver.fact_forecast_demand as f
group by month(f.Date)
)
select*,
format(round((sum(Actual_Demand - Forecast_Demand) over()
/ cast(sum(Actual_Demand)
	over() as float)),4),'p')  as WAPE
from forecast
order by Months asc;
----->>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
--- MAD (Mean Absolute Deviation) ------
with forecast as (
select
month(f.Date) as Months,
sum(f.Actual_Demand_Qty) as Actual_Demand,
sum(f.Forecast_Qty) as Forecast_Demand
from Silver.fact_forecast_demand as f
group by month(f.Date)
)
select*,
avg(abs(f.Actual_Demand -f.Forecast_Demand)) over() as MAD
from forecast as f;
---->>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
--- RMSE (Root Mean Squared Error) ------
with forecast as (
select
month(f.Date) as Months,
sum(f.Actual_Demand_Qty) as Actual_Demand,
sum(f.Forecast_Qty) as Forecast_Demand
from Silver.fact_forecast_demand as f
group by month(f.Date)
)
select
t.Months,
t.Actual_Demand,
t.Forecast_Demand,
round(sqrt(t.avg_),3) as RMSE
from 
(select*,
avg(t.s * t.s) over() as avg_
from (
select*,
(f.Actual_Demand - f.Forecast_Demand) as s
from forecast as f
)t
)t;
------>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
--- Tracking Signal ------
with forecast as (
select
month(f.Date) as Months,
sum(f.Actual_Demand_Qty) as Actual_Demand,
sum(f.Forecast_Qty) as Forecast_Demand
from Silver.fact_forecast_demand as f
group by month(f.Date)
)
select*,
round((Cumulative_Forecast_Error /cast(
		MAD as float)),2) as Tracking_Signal
from (
select*,
sum(f.Actual_Demand - f.Forecast_Demand)
	over() as Cumulative_Forecast_Error,
avg(abs(f.Actual_Demand -f.Forecast_Demand))
		over() as MAD
from forecast as f
)t;
----->>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
--- Variance Percentage ------
with forecast as (
select
month(f.Date) as Months,
sum(f.Actual_Demand_Qty) as Actual_Demand,
sum(f.Forecast_Qty) as Forecast_Demand
from Silver.fact_forecast_demand as f
group by month(f.Date)
)
select*,
format(((f.Actual_Demand - f.Forecast_Demand)
	/cast(Forecast_Demand as float)),'p')
			as Variance_Percentage
from forecast as f;
