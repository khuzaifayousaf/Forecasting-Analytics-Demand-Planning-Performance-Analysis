----->>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
----Demand Growth By Months
with Demand_Growth as (
select
Months,
lag(Total_Demand_Qty) over 
		(order by Months) as Previous_Demand_Qty_Month,
Total_Demand_Qty
from (
select
month(f.Date) as Months,
sum(f.Actual_Demand_Qty) as Total_Demand_Qty
from Silver.fact_forecast_demand as f
group by month(f.Date)
)t
)
select
t.Months,
t.Previous_Demand_Qty_Month,
Total_Demand_Qty,
format((round(t.Growth_By_Months,3)),'p') as Growth_By_Months
from(
select*,
(((Total_Demand_Qty - Previous_Demand_Qty_Month)/ cast((
Previous_Demand_Qty_Month) as float))) as Growth_By_Months
from Demand_Growth
)t;
------->>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
----Demand Growth By Quarter
with Growth_By_Quarter as (
select
DATEPART(QUARTER,f.Date) as Quarters,
sum(f.Actual_Demand_Qty) as Demand_Qty
from Silver.fact_forecast_demand as f
group by DATEPART(QUARTER,f.Date)
)
select*,
format(round(((t.Demand_Qty-t.Previous_Quarter_Demand)/
	cast(t.Previous_Quarter_Demand 
			as float)),3),'p') as Quarter_Growth
from (
select*,
lag(q.demand_qty) over (order by q.quarters)
			as Previous_Quarter_Demand
from Growth_By_Quarter as q
)t;
